# Env files (Vite loads by mode; later wins): .env < .env.[mode] < .env.local < .env.[mode].local
#   `npm run dev`   -> .env.development   (emulators, demo project)
#   `npm run build` -> .env.production    (real project)
# Copy this to .env.local to override locally, e.g. to run dev against a real project.

# --- Firebase web config (required: API_KEY, PROJECT_ID, APP_ID) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_DATABASE_URL=

# --- Emulators (all optional) ---
# Ports default to firebase.json.
# VITE_USE_EMULATORS=auto          # true | false | auto (auto = only on localhost)
# VITE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=5703
# VITE_AUTH_EMULATOR_HOST=127.0.0.1
# VITE_AUTH_EMULATOR_PORT=5705
